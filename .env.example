# Required for Google Jobs and Google Form discovery
SERPAPI_KEY=
# Required for alert delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional
PORT=8787
# Override the default walk-in RSS feeds (comma-separated)
WALKIN_RSS_FEEDS=
# One deep scan/day uses about 210 SerpAPI searches/month (free-plan friendly).
SCAN_INTERVAL_MINUTES=1440
# Maximum age of a listing. Listings without a verifiable timestamp are skipped.
JOB_MAX_AGE_HOURS=24
